# Copiar a .env.local (gitignored) para desarrollo local.
# En producción, configurar estas mismas variables en Vercel → Project Settings → Environment Variables.

# Cliente (prefijo VITE_ para que Vite las exponga al navegador)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo funciones serverless (/api) — nunca exponer al cliente
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ya existentes
ANTHROPIC_API_KEY=
PLANTNET_API_KEY=
